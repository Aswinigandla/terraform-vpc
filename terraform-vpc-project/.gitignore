# Terraform working directory and downloaded providers
.terraform/

# Terraform state and plans (may contain sensitive data)
*.tfstate
*.tfstate.*
*.tfplan

# Variable files that may contain secrets
terraform.tfvars
*.auto.tfvars

# Crash logs
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
